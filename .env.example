# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Steam Web API key (from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key_here

# Discord server/guild ID (right-click server name > Copy Server ID)
# Makes slash commands sync instantly instead of waiting up to an hour
GUILD_ID=your_guild_id_here

# Twitch/IGDB credentials (from https://dev.twitch.tv/console)
# Needed for looking up max co-op player counts
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
